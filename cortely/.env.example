# Cortely — projeto isolado (NÃO reutilize .env do FilaDock / FrotaTMS)
# Crie um projeto NOVO no Supabase chamado "cortely" e preencha abaixo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sem essas variáveis, o app sobe em DEMO MODE (dados locais em memória).
NEXT_PUBLIC_DEMO_MODE=true
