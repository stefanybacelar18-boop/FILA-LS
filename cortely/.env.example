# Cortely — projeto isolado (NÃO reutilize .env do FilaDock / FrotaTMS)
# Crie um projeto NOVO no Supabase chamado "cortely" e preencha abaixo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sem Supabase, o app usa DEMO com persistência em disco (.data/cortely-store.json).
# true = força demo mesmo com Supabase preenchido.
# Demo NÃO libera autenticação de cliente sem OTP.
NEXT_PUBLIC_DEMO_MODE=true

# Sessão staff (HMAC). Gere um valor longo e aleatório (mín. 16).
CORTELY_SESSION_SECRET=

# Senhas staff (mín. 8). Sem estes secrets o login falha.
CORTELY_OWNER_PASSWORD=
CORTELY_RECEPTION_PASSWORD=
CORTELY_BARBER_PASSWORD=

# Provedor WhatsApp: meta | evolution (auto se omitido)
WHATSAPP_PROVIDER=

# —— Meta Cloud API (não usar estes campos para Evolution) ——
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
# Legado (ainda lido como Meta):
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0

# —— Evolution API (independente da Meta) ——
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Protege POST /api/reminders/process (cron)
CRON_SECRET=

# Gateways de pagamento (opcional). Sem credencial, Pix é simulado.
MERCADOPAGO_ACCESS_TOKEN=
ASAAS_API_KEY=
