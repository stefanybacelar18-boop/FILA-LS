# Cortely — projeto isolado (NÃO reutilize .env do FilaDock / FrotaTMS)
# Crie um projeto NOVO no Supabase chamado "cortely" e preencha abaixo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sem essas variáveis, o app sobe em DEMO MODE (dados locais em memória).
NEXT_PUBLIC_DEMO_MODE=true

# WhatsApp Business API (opcional). Sem isso, o envio fica em modo manual (wa.me).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0

# Protege POST /api/reminders/process (cron)
CRON_SECRET=
