DATABASE_URL="file:./dev.db"
# Produção / Docker Compose (PostgreSQL):
# DATABASE_URL="postgresql://frota:SENHA@localhost:5432/frota_tms"
#
# Render + Supabase (processo Node longo): Session pooler porta 5432, SEM connection_limit=1
# DATABASE_URL="postgresql://postgres.REF:SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Vercel serverless: Transaction pooler 6543
# DATABASE_URL="postgresql://postgres.REF:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Obrigatório em produção: ≥24 caracteres, único
JWT_SECRET="change-me-in-production-min-24-chars"
JWT_EXPIRES_IN="8h"
PORT=4000

# Dev: URL do Vite. Produção (API serve o front): use o domínio público ou *
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Monitoramento opcional (produção)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Só no primeiro bootstrap: SEED_ON_START=true FORCE_SEED=true
# SEED_ON_START=false
